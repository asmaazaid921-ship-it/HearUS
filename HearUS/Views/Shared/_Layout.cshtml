<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - صوتنا | HearUs</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HearUS.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;

        string NavClass(string area) =>
            string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
                ? "nav-link active fw-semibold"
                : "nav-link";
    }

    <header>
        <div class="a11y-bar">
            <div class="container d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted me-auto">إمكانية الوصول</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-a11y-toggle="large-text"
                        aria-pressed="false">تكبير الخط</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-a11y-toggle="high-contrast"
                        aria-pressed="false">تباين عالٍ</button>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">ص</span>
                    <span>
                        <span class="fw-bold">صوتنا</span>
                        <small class="d-block text-muted brand-subtitle">HearUs</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="فتح القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="@NavClass("")" asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Community")" asp-area="Community" asp-controller="Home" asp-action="Index">المجتمع</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Insights")" asp-area="Insights" asp-controller="Home" asp-action="Index">ركن صوتهم</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Signs")" asp-area="Signs" asp-controller="Home" asp-action="Index">قاموس الإشارة</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Chat")" asp-area="Chat" asp-controller="Home" asp-action="Index">الدردشة</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Jobs")" asp-area="Jobs" asp-controller="Home" asp-action="Index">فرص العمل</a>
                        </li>
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Admin")" asp-area="Admin" asp-controller="Home" asp-action="Index">الإدارة</a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-area="Account" asp-controller="Account" asp-action="Profile">الملف الشخصي</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="Account" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">تسجيل الخروج</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary" asp-area="Account" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                            <a class="btn btn-primary" asp-area="Account" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container py-4">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                </div>
            }

            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="border-top bg-white py-3 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-muted">
            <span>&copy; 2026 صوتنا — HearUs</span>
            <a class="link-secondary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/a11y.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
