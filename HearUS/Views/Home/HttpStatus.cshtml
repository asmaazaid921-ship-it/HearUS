@{
    var code = (int)(ViewData["Code"] ?? 404);
}

<div class="text-center py-5">
    <div class="display-5 fw-bold text-primary mb-2">@code</div>
    <h1 class="h4 fw-bold mb-2">@ViewData["Title"]</h1>
    <p class="text-muted mb-4">
        @if (code == 404)
        {
            <span>قد يكون الرابط غير صحيح أو أن المحتوى لم يعد متاحاً.</span>
        }
        else
        {
            <span>حدث خطأ غير متوقع أثناء تنفيذ طلبك، حاول مرة أخرى.</span>
        }
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">العودة للرئيسية</a>
        <a class="btn btn-outline-primary" asp-area="Community" asp-controller="Home" asp-action="Index">الحائط المشترك</a>
    </div>
</div>
