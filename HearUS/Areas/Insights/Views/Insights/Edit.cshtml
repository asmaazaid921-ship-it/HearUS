@model InsightFormViewModel
@{
    ViewData["Title"] = "تعديل المقال";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-end gap-2 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">تعديل المقال</h1>
                <p class="text-muted mb-0">عدّل النص أو تحكّم في حالة النشر.</p>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-area="Insights" asp-controller="Home"
               asp-action="Details" asp-route-id="@Model.Id">معاينة</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-area="Insights" asp-controller="Insights" asp-action="Edit" asp-route-id="@Model.Id"
                      method="post" novalidate>
                    <partial name="_InsightForm" model="Model" />
                    <button type="submit" class="btn btn-primary px-4">حفظ التعديلات</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
