@model MyInsightsViewModel
@{
    ViewData["Title"] = "مقالاتي";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">مقالاتي</h1>
        <p class="text-muted mb-0">كل ما نشرته أو حفظته كمسودة في ركن صوتهم.</p>
    </div>
    <a class="btn btn-primary" asp-area="Insights" asp-controller="Insights" asp-action="Create">اكتب مقالاً</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h5 fw-bold mb-2">لم تكتب أي مقال بعد</h2>
            <p class="text-muted mb-0">ابدأ بمشاركة أول تجربة لك مع المجتمع.</p>
        </div>
    </div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var insight in Model.Items)
        {
            <div class="list-group-item border-0 border-bottom py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="fw-semibold">@insight.Title</span>
                            @if (insight.IsPublished)
                            {
                                <span class="badge text-bg-success">منشور</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">مسودة</span>
                            }
                        </div>
                        <div class="small text-muted">
                            @insight.Category.ToArabicName()
                            · @((insight.PublishedAt ?? insight.CreatedAt).ToString("d MMMM yyyy"))
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-area="Insights" asp-controller="Home"
                           asp-action="Details" asp-route-id="@insight.Id">عرض</a>
                        <a class="btn btn-sm btn-outline-primary" asp-area="Insights" asp-controller="Insights"
                           asp-action="Edit" asp-route-id="@insight.Id">تعديل</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <partial name="_Pager" model="Model.Pager" />
}
