@model InsightsIndexViewModel
@{
    ViewData["Title"] = "ركن صوتهم";

    var categories = new (InsightCategory? Value, string Label)[]
    {
        (null, "الكل"),
        (InsightCategory.Experience, "تجربة"),
        (InsightCategory.Awareness, "توعية"),
        (InsightCategory.SuccessStory, "قصة نجاح"),
        (InsightCategory.Guidance, "إرشاد")
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">ركن صوتهم</h1>
        <p class="text-muted mb-0">مقالات وتجارب يكتبها أصحاب التجربة أنفسهم.</p>
    </div>
    @if (Model.CanWrite)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-area="Insights" asp-controller="Insights" asp-action="My">مقالاتي</a>
            <a class="btn btn-primary" asp-area="Insights" asp-controller="Insights" asp-action="Create">اكتب مقالاً</a>
        </div>
    }
</div>

<ul class="nav nav-pills flex-wrap gap-2 mb-4">
    @foreach (var (value, label) in categories)
    {
        var isActive = Model.Category == value;
        <li class="nav-item">
            <a class="nav-link @(isActive ? "active" : "text-muted")"
               asp-area="Insights" asp-controller="Home" asp-action="Index"
               asp-route-category="@value">@label</a>
        </li>
    }
</ul>

@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h5 fw-bold mb-2">لا توجد مقالات في هذا التصنيف</h2>
            <p class="text-muted mb-0">ستظهر هنا تجارب أصحاب التجربة فور نشرها.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var insight in Model.Items)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card border-0 shadow-sm h-100 feature-card">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center gap-2 mb-2 small text-muted">
                            <span class="insight-category-dot"></span>
                            <span>@insight.Category.ToArabicName()</span>
                            @if (!string.IsNullOrWhiteSpace(insight.SignVideoUrl))
                            {
                                <span class="badge sign-video-badge ms-auto">بلغة الإشارة</span>
                            }
                        </div>
                        <h2 class="h5 fw-bold mb-2">@insight.Title</h2>
                        <p class="text-muted small flex-grow-1 mb-3">
                            @(string.IsNullOrWhiteSpace(insight.Summary) ? "اقرأ المقال كاملاً..." : insight.Summary)
                        </p>
                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="text-muted">@insight.AuthorName</span>
                            <a class="fw-semibold" asp-area="Insights" asp-controller="Home" asp-action="Details"
                               asp-route-id="@insight.Id">اقرأ المزيد</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

<partial name="_Pager" model="Model.Pager" />
