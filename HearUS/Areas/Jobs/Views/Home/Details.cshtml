@model JobDetailsDto
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="مسار التنقل" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item">
            <a asp-area="Jobs" asp-controller="Home" asp-action="Index">فرص العمل</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<article class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h1 class="h3 fw-bold mb-1">@Model.Title</h1>
                <p class="text-muted mb-0">@Model.CompanyName</p>
            </div>
            @if (!Model.IsActive)
            {
                <span class="badge text-bg-secondary">غير منشورة</span>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4 small">
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <span class="badge job-badge">@Model.Location</span>
            }
            @if (Model.IsRemote)
            {
                <span class="badge job-badge">عمل عن بُعد</span>
            }
            @if (Model.IsAccessibilityFriendly)
            {
                <span class="badge text-bg-success">مهيّأة لذوي الهمم</span>
            }
            <span class="badge text-bg-light text-dark">@TimeAgo.Format(Model.PostedAt)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SignVideoUrl))
        {
            var signVideo = new SignVideoViewModel
            {
                Url = Model.SignVideoUrl,
                Title = "فيديو بلغة الإشارة لوظيفة " + Model.Title
            };
            <partial name="_SignVideo" model="signVideo" />
        }

        <hr />

        <div class="post-content">@Model.Description</div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            @if (!string.IsNullOrWhiteSpace(Model.ApplyUrl))
            {
                <a class="btn btn-primary" href="@Model.ApplyUrl" target="_blank" rel="noopener noreferrer">التقديم على الوظيفة</a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
            {
                <a class="btn btn-outline-primary" href="mailto:@Model.ContactEmail">مراسلة جهة التوظيف</a>
            }
            <a class="btn btn-outline-secondary" asp-area="Jobs" asp-controller="Home" asp-action="Index">كل الوظائف</a>
        </div>
    </div>
</article>
