@model ChatIndexViewModel
@{
    ViewData["Title"] = "الدردشة";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">الدردشة</h1>
        <p class="text-muted mb-0">محادثاتك الفردية، لحظياً ودون إعادة تحميل.</p>
    </div>
    <a class="btn btn-primary" asp-area="Chat" asp-controller="Home" asp-action="New">محادثة جديدة</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h5 fw-bold mb-2">لا توجد محادثات بعد</h2>
            <p class="text-muted mb-3">ابدأ محادثة مع عضو من المجتمع.</p>
            <a class="btn btn-primary" asp-area="Chat" asp-controller="Home" asp-action="New">اختر عضواً للبدء</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <ul class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item p-3">
                    <a class="d-flex align-items-center gap-3 text-reset text-decoration-none"
                       asp-area="Chat" asp-controller="Home" asp-action="Conversation" asp-route-id="@item.Id">
                        <div class="avatar-circle">@item.OtherInitial</div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold">@item.OtherName</span>
                                <span class="small text-muted">@TimeAgo.Format(item.LastActivityAt)</span>
                            </div>
                            <div class="small text-muted text-truncate" style="max-width: 32rem;">
                                @(string.IsNullOrWhiteSpace(item.LastMessage) ? "لا توجد رسائل بعد" : item.LastMessage)
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    </div>
}
