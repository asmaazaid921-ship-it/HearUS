@model NewChatViewModel
@{
    ViewData["Title"] = "محادثة جديدة";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">محادثة جديدة</h1>
        <p class="text-muted mb-0">ابحث عن عضو وابدأ محادثة فردية.</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary" asp-area="Chat" asp-controller="Home" asp-action="Index">
        كل المحادثات
    </a>
</div>

<form class="d-flex gap-2 mb-4" asp-area="Chat" asp-controller="Home" asp-action="New" method="get">
    <input class="form-control" name="q" value="@Model.Search" placeholder="ابحث بالاسم أو البريد الإلكتروني..." />
    <button class="btn btn-primary text-nowrap" type="submit">بحث</button>
</form>

@if (Model.Users.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">لا يوجد أعضاء مطابقون.</div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <ul class="list-group list-group-flush">
            @foreach (var user in Model.Users)
            {
                <li class="list-group-item d-flex align-items-center gap-3 p-3">
                    <div class="avatar-circle">@(string.IsNullOrEmpty(user.FullName) ? "؟" : user.FullName[..1])</div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@user.FullName</div>
                        <div class="small text-muted" dir="ltr">@user.Email</div>
                    </div>
                    <form asp-area="Chat" asp-controller="Home" asp-action="Start" asp-route-userId="@user.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-primary">بدء المحادثة</button>
                    </form>
                </li>
            }
        </ul>
    </div>
}
