@model ProfileViewModel
@{
    ViewData["Title"] = "الملف الشخصي";

    string RoleLabel(string role) => role switch
    {
        "Admin" => "مشرف",
        "Expert" => "صاحب تجربة",
        "Member" => "عضو مجتمع",
        _ => role
    };
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">
                <div class="profile-avatar mx-auto mb-3">@Model.FullName.Substring(0, 1)</div>
                <h1 class="h5 fw-bold mb-1">@Model.FullName</h1>
                <p class="text-muted mb-3" dir="ltr">@Model.Email</p>

                @foreach (var role in Model.Roles)
                {
                    <span class="badge rounded-pill text-bg-primary me-1">@RoleLabel(role)</span>
                }

                <hr />

                <dl class="row text-start mb-0 small">
                    <dt class="col-5 text-muted">المدينة</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.City) ? "غير محددة" : Model.City)</dd>

                    <dt class="col-5 text-muted">عضو منذ</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("d MMMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row g-4 mb-4">
            <div class="col-sm-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1 small">منشوراتي في المجتمع</p>
                        <p class="display-6 fw-bold mb-0">@Model.PostsCount</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1 small">مقالات ركن صوتهم</p>
                        <p class="display-6 fw-bold mb-0">@Model.InsightsCount</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6 fw-bold mb-3">نبذة عني</h2>
                <p class="mb-0 text-muted">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "لم تُضف نبذة بعد." : Model.Bio)
                </p>
            </div>
        </div>
    </div>
</div>
