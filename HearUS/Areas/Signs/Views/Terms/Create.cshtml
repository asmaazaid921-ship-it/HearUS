@model SignFormViewModel
@{
    ViewData["Title"] = "إشارة جديدة";
}

<nav aria-label="مسار التنقل" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item">
            <a asp-area="Signs" asp-controller="Home" asp-action="Index">قاموس الإشارة</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">إشارة جديدة</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <h1 class="h4 fw-bold mb-1">إضافة إشارة</h1>
        <p class="text-muted mb-4">أضف كلمة أو عبارة مع فيديو الإشارة المقابلة.</p>

        <form asp-area="Signs" asp-controller="Terms" asp-action="Create" method="post">
            <partial name="_SignForm" model="Model" />

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-4">حفظ الإشارة</button>
                <a class="btn btn-outline-secondary" asp-area="Signs" asp-controller="Home" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
