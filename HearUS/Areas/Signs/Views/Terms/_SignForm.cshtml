@model SignFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Term" class="form-label"></label>
        <input asp-for="Term" class="form-control" maxlength="100" placeholder="مثال: صباح الخير" />
        <span asp-validation-for="Term" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
            @foreach (var category in Enum.GetValues<SignCategory>())
            {
                <option value="@category">@category.ToArabicName()</option>
            }
        </select>
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>
</div>

<div class="mt-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"
              placeholder="سياق استخدام الإشارة أو ملاحظات مساعدة."></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mt-3">
    <label asp-for="VideoUrl" class="form-label"></label>
    <input asp-for="VideoUrl" class="form-control" dir="ltr" maxlength="500"
           placeholder="https://www.youtube.com/watch?v=..." />
    <div class="form-text">رابط YouTube أو Vimeo أو ملف فيديو مباشر (mp4/webm/ogg) يبدأ بـ https.</div>
    <span asp-validation-for="VideoUrl" class="text-danger small"></span>
</div>

<div class="alert alert-light border mt-4 mb-0 small">
    تأكد أن الفيديو واضح، بلغة الإشارة المستخدمة في مجتمعك، وأنك تملك حق نشره.
</div>
