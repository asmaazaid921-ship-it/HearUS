@model AdminJobsViewModel
@{
    ViewData["Title"] = "إدارة الوظائف";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">إدارة الوظائف</h1>
        <p class="text-muted mb-0">أضف الوظائف وتحكّم في نشرها.</p>
    </div>
    <div class="d-flex gap-2">
        <form class="d-flex gap-2" asp-area="Admin" asp-controller="Jobs" asp-action="Index" method="get">
            <input class="form-control" name="search" value="@Model.Search" placeholder="بحث..." />
            <button class="btn btn-outline-primary text-nowrap" type="submit">بحث</button>
        </form>
        <a class="btn btn-primary text-nowrap" asp-area="Admin" asp-controller="Jobs" asp-action="Create">وظيفة جديدة</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    @if (Model.Items.Count == 0)
    {
        <div class="card-body text-center py-5 text-muted">لا توجد وظائف مطابقة.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>الوظيفة</th>
                        <th>الشركة</th>
                        <th>الموقع</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@job.Title</td>
                            <td class="text-muted">@job.CompanyName</td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(job.Location) ? "—" : job.Location)</td>
                            <td>
                                @if (job.IsActive)
                                {
                                    <span class="badge text-bg-success">منشورة</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">موقوفة</span>
                                }
                            </td>
                            <td class="text-muted small">@job.PostedAt.ToString("d MMM yyyy")</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Jobs"
                                   asp-action="Edit" asp-route-id="@job.Id">تعديل</a>
                                <form class="d-inline" asp-area="Admin" asp-controller="Jobs" asp-action="ToggleActive"
                                      asp-route-id="@job.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(job.IsActive ? "إيقاف" : "نشر")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
