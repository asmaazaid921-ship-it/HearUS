@model JobFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="150" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" maxlength="100" />
        <span asp-validation-for="CompanyName" class="text-danger small"></span>
    </div>
</div>

<div class="mt-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="8" maxlength="4000"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mt-3">
    <label asp-for="SignVideoUrl" class="form-label"></label>
    <input asp-for="SignVideoUrl" class="form-control" dir="ltr" placeholder="https://www.youtube.com/watch?v=..." maxlength="500" />
    <div class="form-text">فيديو قصير يشرح الوظيفة بلغة الإشارة (YouTube/Vimeo أو ملف mp4/webm/ogg).</div>
    <span asp-validation-for="SignVideoUrl" class="text-danger small"></span>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" maxlength="100" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ApplyUrl" class="form-label"></label>
        <input asp-for="ApplyUrl" class="form-control" dir="ltr" placeholder="https://..." maxlength="300" />
        <span asp-validation-for="ApplyUrl" class="text-danger small"></span>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <label asp-for="ContactEmail" class="form-label"></label>
        <input asp-for="ContactEmail" class="form-control" dir="ltr" maxlength="150" />
        <span asp-validation-for="ContactEmail" class="text-danger small"></span>
    </div>
    <div class="col-md-6 d-flex align-items-end">
        <div class="d-flex flex-column gap-2">
            <div class="form-check">
                <input asp-for="IsRemote" class="form-check-input" />
                <label asp-for="IsRemote" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="IsAccessibilityFriendly" class="form-check-input" />
                <label asp-for="IsAccessibilityFriendly" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
</div>
